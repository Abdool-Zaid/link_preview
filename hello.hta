<html>
<head>
    <title>Hello World HTA</title>
    <HTA:APPLICATION 
        ID="HelloWorld"
        APPLICATIONNAME="HelloWorld"
        WINDOWSTATE="normal"
        CAPTION="yes"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes">
</head>
<body>
    <h1>Hello, World!</h1>
    <p>This is a simple HTML Application running via mshta.exe.</p>
    <button onclick="window.close()">Close</button>
</body>
</html>